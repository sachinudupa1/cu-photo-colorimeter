# Firebase project used by Firebase Authentication and Cloud Firestore.
FIREBASE_PROJECT_ID=cu-photo-colorimeter

# Private Supabase Storage configuration. Use a server-only Secret key here.
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_BUCKET_NAME=cu-photo-images
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key

# Include the local Vite origins and the two production Firebase Hosting origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://cu-photo-lab.web.app,https://cu-photo-colorimeter.web.app
REQUIRE_APP_CHECK=false
MAX_UPLOAD_BYTES=3145728
MAX_PHOTOS_PER_SAMPLE=8
MAX_PREDICTIONS_PER_MINUTE_PER_PROCESS=6
MODEL_STORAGE_PREFIX=models

# Local development uses Google Application Default Credentials:
# gcloud auth application-default login
# Render only: GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/cu-photo-render-runtime.json
